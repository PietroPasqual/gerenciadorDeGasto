# URL do projeto Supabase (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave publica "anon" (Project Settings -> API -> anon public).
# E a UNICA chave que pode aparecer no cliente. NUNCA use a service_role aqui:
# ela ignora RLS e daria acesso a todos os dados de todos os usuarios.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional: usado apenas pelo script `npm run types:gen` (roda localmente, fora do bundle)
SUPABASE_PROJECT_ID=xxxxxxxxxxxxxxxx
